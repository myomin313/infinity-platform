pipeline {
  agent any

  environment {
    BRANCH = "test"
    DEPLOY_USER = "jenkins"  // Update if different
    TARGET_DIR = "/var/www/html/test/ost-platform-api"
    DEPLOY_HOST = "31.97.125.9"
  }

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  stages {

    stage('📥 Checkout from GitLab') {
      steps {
        echo "Checking out '${BRANCH}' branch from GitLab..."
        git branch: "${BRANCH}",
            credentialsId: 'gitlab-ssh',
            url: 'git@gitlab.com:myominost/ost-platform-api.git'
      }
    }

    stage('🔧 Build API') {
      steps {
        echo "Running build for TEST environment..."
        sh '''
          npm install
          npm run build || echo "No build step defined"
        '''
      }
    }

    stage('🚀 Deploy to Server') {
      steps {
        echo "Deploying to ${DEPLOY_HOST}:${TARGET_DIR} and restarting app..."

        sshagent(['deploy-key']) {
          sh """
            rsync -avz --delete ./ ${DEPLOY_USER}@${DEPLOY_HOST}:${TARGET_DIR}

            ssh ${DEPLOY_USER}@${DEPLOY_HOST} '
              cd ${TARGET_DIR} &&
              if pm2 describe ost-api > /dev/null; then
                pm2 reload ost-api
              else
                pm2 start app.js --name ost-api
              fi &&
              pm2 save
            '
          """
        }
      }
    }
  }
}
