pipeline {
  agent any

  environment {
    BRANCH = "test"
    DEPLOY_USER = "jenkins"  // Replace if needed
    TARGET_DIR = "/var/www/html/test/ost-platform-api"
    DEPLOY_HOST = "31.97.125.9"
  }

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  stages {

    stage('📥 Checkout from GitLab') {
      steps {
        echo "Checking out '${BRANCH}' branch from GitLab..."
        git branch: "${BRANCH}",
            credentialsId: 'gitlab-ssh',
            url: 'git@gitlab.com:myominost/ost-platform-api.git'
      }
    }

    stage('🔧 Build API') {
      steps {
        echo "Running build for TEST environment..."
        sh '''
          npm install
          pm2 restart app.js
        '''
      }
    }

    stage('🚀 Deploy to Server') {
      steps {
        echo "Deploying to ${DEPLOY_HOST}:${TARGET_DIR}..."

        sshagent(['deploy-key']) {
          sh """
            rsync -avz --delete ./build/ ${DEPLOY_USER}@${DEPLOY_HOST}:${TARGET_DIR}
          """
        }
      }
    }
  }
}
